<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HAWK</title>
<style>
:root{--bg:#0c0a1a;--card:#17152d;--card2:#1f1d3a;--purple:#7c3aed;--red:#ff2a2a;--yellow:#ffb800;--green:#00e676}
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}
body{background:var(--bg);color:white;padding:14px 14px 90px}
.header{display:flex;align-items:center;gap:10px}
.hawk-logo{width:36px;height:36px;background:white;color:black;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px;border-radius:8px}
.logo-text{font-weight:900;letter-spacing:3px;font-size:22px}
.hint{text-align:center;color:#5a5880;font-size:9px;letter-spacing:2px;margin:14px 0}
.box{background:var(--card);border:1px solid #2a2850;border-radius:20px;padding:14px;margin:10px 0}
.box input,.box textarea{width:100%;background:transparent;border:none;outline:none;color:white;font-size:14px}
.box textarea{height:72px;resize:none}
.tabs{display:flex;background:var(--card);border-radius:30px;padding:5px;gap:5px;margin:14px 0}
.tab{flex:1;text-align:center;padding:12px;border-radius:25px;font-weight:800;font-size:12px;cursor:pointer;color:#6b6a8a}
.tab.active{background:var(--purple);color:white}
.btn{width:100%;background:var(--purple);border:none;color:white;padding:16px;border-radius:18px;font-weight:900;cursor:pointer;margin:8px 0}
.result{background:var(--card);border-radius:22px;padding:18px;border:1px solid #2a2850;display:none;margin-top:12px}
.circle{width:92px;height:92px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:900;border:6px solid}
.threat{display:flex;justify-content:space-between;background:var(--card2);padding:11px;border-radius:12px;margin:7px 0;font-size:11px}
.dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:7px}
.adminInput{background:#0f0e22;border:1px solid #2a2850;color:white;padding:11px;border-radius:12px;width:100%;margin:7px 0}
.bottom{position:fixed;bottom:10px;left:14px;right:14px;background:var(--card);border-radius:22px;padding:12px;display:flex;justify-content:space-around;border:1px solid #2a2850}
.bottom span{font-size:10px;color:#6b6a8a;cursor:pointer;text-align:center}
.bottom span.active{color:#a78bfa}
</style>
</head>
<body>
<div class="header">
<div class="hawk-logo">◩</div>
<div class="logo-text">HAWK</div>
</div>
<div class="hint">PASTE LINK OR MESSAGE. HAWK WILL INSPECT</div>

<div class="box" id="linkBox"><input id="linkInput" placeholder="Paste suspicious link or message"></div>
<div class="box" id="msgBox" style="display:none"><textarea id="msgInput" placeholder="Paste message here..."></textarea></div>

<div class="tabs">
<div class="tab active" id="tabLink" onclick="setMode('link')">LINK SCAN</div>
<div class="tab" id="tabMsg" onclick="setMode('msg')">MESSAGE SCAN</div>
</div>

<button class="btn" onclick="deployHawk()">DEPLOY HAWK ></button>

<div class="result" id="result">
<div style="display:flex;gap:16px;align-items:center">
<div class="circle" id="scoreCircle">0</div>
<div><div style="font-size:9px;letter-spacing:2px;color:#6b6a8a">HAWK VERDICT</div>
<div id="verdict" style="font-weight:900;font-size:24px"></div>
<div style="font-size:11px;color:#6b6a8a">RISK SCORE <span id="scoreNum">0</span>/100</div></div>
</div>
<div id="reason" style="margin:14px 0;padding:10px 12px;border-left:4px solid var(--purple);background:#0f0e22;border-radius:8px;color:#c4c2e0;font-size:12px"></div>
<div id="signals"></div>
<div style="background:#0f0e22;border-radius:14px;padding:12px;margin-top:12px">
<div style="display:flex;align-items:center;gap:6px;font-size:10px;color:#a78bfa;font-weight:800"><span style="width:20px;height:20px;background:white;color:black;display:flex;align-items:center;justify-content:center;border-radius:4px">◩</span> HAWK INTEL</div>
<div id="aiReason" style="font-size:12px;color:#d1d0e6;margin-top:8px;line-height:1.5"></div>
<input id="askInput" class="adminInput" placeholder="Ask HAWK: Why is this risky?" onkeypress="if(event.key==='Enter') askHawk()">
</div>
</div>

<div class="box" id="adminPanel" style="display:none">
<div style="display:flex;align-items:center;gap:8px"><div class="hawk-logo" style="width:28px;height:28px;font-size:14px">◩</div><h3>HAWK ADMIN</h3></div>
<input id="pinInput" class="adminInput" type="password" placeholder="Enter PIN">
<button class="btn" style="padding:11px" onclick="unlockAdmin()">UNLOCK</button>
<div id="adminInside" style="display:none">
<div style="display:flex;gap:10px;margin:12px 0">
<div style="flex:1;background:var(--card2);padding:12px;border-radius:14px;text-align:center"><div id="total" style="font-size:22px;font-weight:900">0</div><div style="font-size:8px;color:#6b6a8a">TOTAL SCANS</div></div>
<div style="flex:1;background:var(--card2);padding:12px;border-radius:14px;text-align:center"><div id="high" style="font-size:22px;font-weight:900;color:var(--red)">0</div><div style="font-size:8px;color:#6b6a8a">HIGH RISK SCANS</div></div>
</div>
<div id="history" style="max-height:180px;overflow:auto;font-size:11px;color:#8a89a8;background:#0f0e22;border-radius:12px;padding:8px"></div>
<button class="btn" style="background:var(--red);font-size:11px;padding:10px" onclick="clearAll()">Clear All Scans</button>
</div>
</div>

<div class="bottom">
<span class="active" onclick="showPage('scan')"><span style="font-size:14px">◩</span><br>SCAN</span>
<span onclick="showPage('admin')">◉<br>ADMIN</span>
</div>

<script>
const PIN_HASH = "d0d9f11d1bf405757a83913bd23dd8abb03ba758bb72de44163b2f921218a391";
async function hashPIN(pin){const enc=new TextEncoder().encode(pin);const buf=await crypto.subtle.digest('SHA-256',enc);return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');}
let MODE='link'; let HISTORY=JSON.parse(localStorage.getItem('hawk_h')||'[]');
function setMode(m){MODE=m;document.getElementById('tabLink').classList.toggle('active',m==='link');document.getElementById('tabMsg').classList.toggle('active',m==='msg');document.getElementById('linkBox').style.display=m==='link'?'block':'none';document.getElementById('msgBox').style.display=m==='msg'?'block':'none';}
function showPage(p){document.getElementById('result').style.display=p==='scan'&&document.getElementById('result').dataset.has?'block':'none';document.getElementById('adminPanel').style.display=p==='admin'?'block':'none';document.querySelectorAll('.bottom span').forEach((s,i)=>s.classList.toggle('active',(p==='scan'&&i===0)||(p==='admin'&&i===1)));}
function analyze(text){
let lower=text.toLowerCase();let score=0,reasons=[],signals=[];
if(lower.match(/bank|bvn|account|pin|card/)){score+=45;signals.push(['Bank Data Request','BAD','red']);reasons.push('Requests bank/BVN/PIN - banks never do this');}else signals.push(['Bank Data','GOOD','green']);
if(lower.match(/win|won|congrat|lottery|prize/)){score+=35;signals.push(['Fake Win Lure','BAD','red']);reasons.push('Fake win/prize lure');}
if(lower.match(/urgent|immediately|verify|click/)){score+=10;signals.push(['Urgency Trick','WARN','yellow']);}
if(text.startsWith('http')){try{let u=new URL(text);if(u.protocol!=='https:'){score+=20;signals.push(['No HTTPS','BAD','red']);} if(u.hostname.split('.').length>4)score+=10;}catch(e){score+=20}}
if(lower.includes('bank')&&lower.includes('win'))score=94;
if(score===0){signals.push(['Structure','GOOD','green']);reasons.push('No critical pattern detected');}
let aiExp=score>=75?'🚨 HIGH RISK CONFIRMED. This matches known fraud pattern. Do not send details, block sender.':score>=40?'⚠️ MEDIUM RISK. Verify sender before any action.':'✅ LOW RISK. Still stay vigilant.';
return{score:Math.min(score,99),reasons,signals,aiExp}
}
function deployHawk(){
let text=(MODE==='link'?document.getElementById('linkInput').value:document.getElementById('msgInput').value).trim();if(!text)return alert('Paste something');
let ai=analyze(text);
let res=document.getElementById('result');res.style.display='block';res.dataset.has='1';
let circle=document.getElementById('scoreCircle');let verdict=document.getElementById('verdict');
circle.textContent=ai.score;document.getElementById('scoreNum').textContent=ai.score;
if(ai.score>=75){circle.style.borderColor='var(--red)';circle.style.color='var(--red)';circle.style.background='#ff2a2a18';verdict.textContent='HIGH RISK';verdict.style.color='var(--red)';document.getElementById('reason').style.borderColor='var(--red)';}
else if(ai.score>=40){circle.style.borderColor='var(--yellow)';circle.style.color='var(--yellow)';circle.style.background='#ffb80018';verdict.textContent='MEDIUM RISK';verdict.style.color='var(--yellow)';document.getElementById('reason').style.borderColor='var(--yellow)';}
else{circle.style.borderColor='var(--green)';circle.style.color='var(--green)';circle.style.background='#00e67618';verdict.textContent='LOW RISK';verdict.style.color='var(--green)';document.getElementById('reason').style.borderColor='var(--green)';}
document.getElementById('reason').innerHTML='• '+ai.reasons.join('<br>• ');
document.getElementById('signals').innerHTML=ai.signals.map(s=>{let col=s[2]==='red'?'var(--red)':s[2]==='yellow'?'var(--yellow)':'var(--green)';return `<div class="threat"><span><span class="dot" style="background:${col}"></span>${s[0]}</span><span style="color:${col};font-weight:800">${s[1]}</span></div>`}).join('');
document.getElementById('aiReason').innerHTML=ai.aiExp;
HISTORY.unshift({time:new Date().toLocaleString(),score:ai.score,text:text.slice(0,55)});localStorage.setItem('hawk_h',JSON.stringify(HISTORY.slice(0,100)));updateAdmin();res.scrollIntoView({behavior:'smooth'});
}
function askHawk(){let q=document.getElementById('askInput').value.trim();if(!q)return;let score=parseInt(document.getElementById('scoreNum').textContent)||0;let ans=score>=75?'Because score '+score+' RED. Requests bank details + win lure = classic scam. Do not click.':'No critical risk but verify source.';document.getElementById('aiReason').innerHTML=ans;document.getElementById('askInput').value='';}
async function unlockAdmin(){let h=await hashPIN(document.getElementById('pinInput').value);if(h===PIN_HASH){document.getElementById('adminInside').style.display='block';updateAdmin();}else alert('Wrong PIN');}
function updateAdmin(){document.getElementById('total').textContent=HISTORY.length;document.getElementById('high').textContent=HISTORY.filter(h=>h.score>=75).length;document.getElementById('history').innerHTML=HISTORY.map(h=>`<div style="padding:7px;border-bottom:1px solid #1f1d3a;display:flex;justify-content:space-between"><span style="color:${h.score>=75?'var(--red)':h.score>=40?'var(--yellow)':'var(--green)'};font-weight:800">[${h.score}]</span><span style="flex:1;margin:0 8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${h.text}</span><span style="color:#5a5880">${h.time}</span></div>`).join('')||'No scans yet';}
function clearAll(){if(confirm('Clear all scans?')){HISTORY=[];localStorage.removeItem('hawk_h');updateAdmin();}}
updateAdmin();
</script>
</body>
</html>
